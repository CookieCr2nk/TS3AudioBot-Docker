<header class="page-head">
  <div>
    <h1><%= t("Bots") %></h1>
    <p class="muted"><%= t("Each entry is a TS3AudioBot with its own web API.") %></p>
  </div>
  <a class="btn btn-primary" href="/admin/bots/new"><%= t("Add bot") %></a>
</header>

<% if (!bots.length) { %><p class="muted"><%= t("No bot has been added yet.") %></p><% } %>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th><%= t("Name") %></th><th><%= t("API") %></th><th><%= t("Instance") %></th><th><%= t("Users") %></th><th></th></tr>
    </thead>
    <tbody>
      <% bots.forEach(function (item) { %>
        <tr>
          <td>
            <%= item.name %>
            <% if (!item.enabled) { %><span class="pill pill-bad"><%= t("Off") %></span><% } %>
          </td>
          <td class="mono"><%= item.baseUrl %></td>
          <td class="mono"><%= item.instanceMode %><% if (item.instanceRef) { %> / <%= item.instanceRef %><% } %></td>
          <td><%= item.grantCount %></td>
          <td><a class="btn btn-ghost" href="/admin/bots/<%= item.id %>"><%= t("Edit") %></a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
