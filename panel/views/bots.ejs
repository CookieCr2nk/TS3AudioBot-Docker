<header class="page-head">
  <div>
    <h1><%= t("Instances") %></h1>
    <p class="muted"><%= t("Each entry is one Docker container. Several TeamSpeak bots can run inside it.") %></p>
  </div>
  <a class="btn btn-primary" href="/admin/instances/new"><%= t("Add instance") %></a>
</header>

<% if (!bots.length) { %><p class="muted"><%= t("No instance has been added yet.") %></p><% } %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= t("Name") %></th>
        <th><%= t("API") %></th>
        <th><%= t("Owner") %></th>
        <th><%= t("Bots") %></th>
        <th><%= t("Users") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% bots.forEach(function (item) { %>
        <tr>
          <td>
            <%= item.name %>
            <% if (!item.enabled) { %><span class="pill pill-bad"><%= t("Off") %></span><% } %>
          </td>
          <td class="mono"><%= item.baseUrl %></td>
          <td><%= item.ownerName || "—" %></td>
          <td><%= item.botCount %></td>
          <td><%= item.grantCount %></td>
          <td class="actions-cell">
            <a class="btn btn-ghost" href="/instances/<%= item.id %>"><%= t("Open") %></a>
            <a class="btn btn-ghost" href="/admin/instances/<%= item.id %>"><%= t("Edit") %></a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
