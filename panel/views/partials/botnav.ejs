<nav class="tabs" aria-label="Bot">
  <a href="/bots/<%= bot.id %>" <%= tab === "player" ? 'aria-current="page"' : "" %>><%= t("Playback") %></a>
  <a href="/bots/<%= bot.id %>/playlists" <%= tab === "playlists" ? 'aria-current="page"' : "" %>><%= t("Playlists") %></a>
  <a href="/bots/<%= bot.id %>/streams" <%= tab === "streams" ? 'aria-current="page"' : "" %>><%= t("Radio") %></a>
  <a href="/bots/<%= bot.id %>/history" <%= tab === "history" ? 'aria-current="page"' : "" %>><%= t("History") %></a>
  <% if (bot.instanceId) { %>
    <a href="/instances/<%= bot.instanceId %>"><%= t("Instance") %></a>
  <% } %>
  <% if (user && user.role === "admin") { %>
    <a href="/bots/<%= bot.id %>/connection" <%= tab === "connection" ? 'aria-current="page"' : "" %>><%= t("Connection") %></a>
  <% } %>
</nav>
