<header class="page-head">
  <div>
    <h1><%= editing ? instance.name : t("Add instance") %></h1>
    <p class="muted"><%= t("On the Compose network the API address is enough. A token is stored encrypted only if you enter one.") %></p>
  </div>
  <% if (editing) { %><a class="btn btn-ghost" href="/instances/<%= instance.id %>"><%= t("Open instance") %></a><% } %>
</header>

<% if (error) { %><p class="flash flash-error" role="alert"><%= error %></p><% } %>

<form method="post" action="<%= editing ? "/admin/instances/" + instance.id : "/admin/instances" %>" class="card stack">
  <%- include("partials/csrf") %>
  <label><%= t("Display name") %>
    <input name="name" required maxlength="120" value="<%= instance.name %>">
  </label>
  <label><%= t("API address") %>
    <input name="baseUrl" required maxlength="255" value="<%= instance.baseUrl %>" placeholder="http://ts3audiobot:58913">
  </label>
  <label><%= t("Owner") %>
    <select name="ownerUserId">
      <option value="" <%= instance.ownerUserId ? "" : "selected" %>><%= t("No owner") %></option>
      <% users.forEach(function (account) { %>
        <option value="<%= account.id %>" <%= String(instance.ownerUserId) === String(account.id) ? "selected" : "" %>><%= account.username %></option>
      <% }) %>
    </select>
  </label>
  <p class="muted"><%= t("The owner can create and delete TeamSpeak bots. Granted users can control playback.") %></p>
  <%- include("partials/rights") %>
  <h2><%= t("API access") %></h2>
  <p class="muted"><%= t("Leave this empty on the Compose network. Fill it in only when the bot is outside that network and requires a token.") %></p>
  <div class="split">
    <label class="grow"><%= t("API UID") %>
      <input name="apiUser" maxlength="128" value="<%= instance.apiUser %>" autocomplete="off">
    </label>
    <label class="grow"><%= t("API token") %>
      <input name="apiToken" type="password" maxlength="512" autocomplete="off" placeholder="<%= editing && instance.hasToken ? t("Leave blank to keep the saved token") : t("optional, or uid:token") %>">
    </label>
  </div>
  <% if (editing && instance.hasToken) { %>
    <label class="check"><input type="checkbox" name="clearToken" value="on"> <%= t("Remove saved token") %></label>
  <% } %>
  <label><%= t("Note") %>
    <textarea name="notes" maxlength="500" rows="3"><%= instance.notes %></textarea>
  </label>
  <label class="check"><input type="checkbox" name="enabled" value="on" <%= instance.enabled ? "checked" : "" %>> <%= t("Instance is enabled") %></label>

  <h2><%= t("Grants") %></h2>
  <p class="muted"><%= t("Administrators and the owner already have access. Assign other users here. They can control bots, not create them.") %></p>
  <% const customers = users.filter(function (account) { return account.role !== "admin" && String(account.id) !== String(instance.ownerUserId); }); %>
  <% if (!customers.length) { %>
    <p class="muted"><%= t("No ordinary user yet. Create one under Users.") %></p>
  <% } %>
  <% customers.forEach(function (account) { %>
    <% const grant = grantMap[account.id]; %>
    <div class="grant">
      <label class="check"><input type="checkbox" name="grant_<%= account.id %>" value="on" <%= grant ? "checked" : "" %>> <%= account.username %></label>
      <label class="check"><input type="checkbox" name="control_<%= account.id %>" value="on" <%= !grant || grant.canControl ? "checked" : "" %>> <%= t("Control") %></label>
    </div>
  <% }) %>

  <button class="btn btn-primary" type="submit"><%= t("Save") %></button>
</form>

<% if (editing) { %>
  <form method="post" action="/admin/instances/<%= instance.id %>/test">
    <%- include("partials/csrf") %>
    <button class="btn" type="submit"><%= t("Check connection") %></button>
  </form>

  <form method="post" action="/admin/instances/<%= instance.id %>/delete" class="card stack danger-zone">
    <%- include("partials/csrf") %>
    <h2><%= t("Delete instance") %></h2>
    <p class="muted"><%= t("Removes this instance from the panel. The container and the bot files stay.") %></p>
    <label><%= t("Type the instance name to confirm") %>
      <input name="confirm" required maxlength="120">
    </label>
    <button class="btn btn-danger" type="submit"><%= t("Delete") %></button>
  </form>
<% } %>
