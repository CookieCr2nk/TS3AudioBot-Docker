<header class="page-head">
  <div>
    <h1><%= t("Users") %></h1>
    <p class="muted"><%= t("Panel accounts. These are not TeamSpeak identities.") %></p>
  </div>
</header>

<% if (error) { %><p class="flash flash-error" role="alert"><%= error %></p><% } %>

<form method="post" action="/admin/users" class="card stack">
  <%- include("partials/csrf") %>
  <h2><%= t("Create") %></h2>
  <div class="split">
    <label><%= t("Username") %>
      <input name="username" required maxlength="32" pattern="[A-Za-z0-9][A-Za-z0-9._\-]{2,31}" autocomplete="off">
    </label>
    <label><%= t("Password") %>
      <input name="password" type="password" required minlength="10" autocomplete="new-password">
    </label>
    <label><%= t("Role") %>
      <select name="role">
        <option value="user"><%= t("User") %></option>
        <option value="admin"><%= t("Administrator") %></option>
      </select>
    </label>
    <button class="btn btn-primary" type="submit"><%= t("Create") %></button>
  </div>
</form>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th><%= t("Name") %></th><th><%= t("Role") %></th><th><%= t("Last login") %></th><th><%= t("Password") %></th><th></th></tr>
    </thead>
    <tbody>
      <% users.forEach(function (account) { %>
        <tr>
          <td><%= account.username %></td>
          <td>
            <form method="post" action="/admin/users/<%= account.id %>/role" class="inline">
              <%- include("partials/csrf") %>
              <select name="role">
                <option value="user" <%= account.role === "user" ? "selected" : "" %>><%= t("User") %></option>
                <option value="admin" <%= account.role === "admin" ? "selected" : "" %>><%= t("Administrator") %></option>
              </select>
              <button class="btn btn-ghost" type="submit"><%= t("Save") %></button>
            </form>
          </td>
          <td><%= account.lastLoginAt ? formatTime(account.lastLoginAt) : "—" %></td>
          <td>
            <form method="post" action="/admin/users/<%= account.id %>/password" class="inline">
              <%- include("partials/csrf") %>
              <input name="password" type="password" required minlength="10" autocomplete="new-password" placeholder="<%= t("New password") %>">
              <button class="btn btn-ghost" type="submit"><%= t("Set") %></button>
            </form>
          </td>
          <td>
            <% if (account.id !== user.id) { %>
              <form method="post" action="/admin/users/<%= account.id %>/delete" class="inline">
                <%- include("partials/csrf") %>
                <label class="check"><input type="checkbox" name="confirm" value="on" required> <%= t("Delete") %></label>
                <button class="btn btn-danger" type="submit"><%= t("Remove") %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
