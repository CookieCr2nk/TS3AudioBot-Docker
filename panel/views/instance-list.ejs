<header class="page-head">
  <div>
    <h1><%= t("Instances") %></h1>
    <p class="muted"><%= t("Each entry is one Docker container. Several TeamSpeak bots can run inside it.") %></p>
  </div>
  <% if (admin) { %><a class="btn btn-primary" href="/admin/instances/new"><%= t("Add instance") %></a><% } %>
</header>

<% if (!instances.length) { %>
  <p class="muted"><%= admin ? t("No instance has been added yet.") : t("No instance assigned") %></p>
<% } %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= t("Name") %></th>
        <th><%= t("Owner") %></th>
        <th><%= t("Bots") %></th>
        <% if (admin) { %><th><%= t("API") %></th><% } %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% instances.forEach(function (item) { %>
        <tr>
          <td>
            <%= item.name %>
            <% if (!item.enabled) { %><span class="pill pill-bad"><%= t("Off") %></span><% } %>
          </td>
          <td><%= item.ownerName || "—" %></td>
          <td><%= item.botCount %></td>
          <% if (admin) { %><td class="mono"><%= item.baseUrl %></td><% } %>
          <td><a class="btn btn-ghost" href="/instances/<%= item.id %>"><%= t("Open") %></a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
