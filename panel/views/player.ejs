<% var song = status && status.song; %>
<header class="page-head">
  <div>
    <h1><%= bot.name %></h1>
    <p class="muted">
      <% if (bot.instanceMode === "none") { %>Ohne Instanzkontext<% } %>
      <% if (bot.instanceMode === "template") { %>Template <%= bot.instanceRef %><% } %>
      <% if (bot.instanceMode === "id") { %>Instanz-ID <%= bot.instanceRef %><% } %>
      <% if (!access.canControl) { %> · nur lesen<% } %>
      <% if (!bot.enabled) { %> · deaktiviert<% } %>
    </p>
  </div>
</header>
<%- include("partials/botnav") %>

<% if (bot.notes) { %><p class="note"><%= bot.notes %></p><% } %>
<% if (statusError) { %>
  <p class="flash flash-error" role="alert"><%= statusError %></p>
  <% if (rightsHint) { %><%- include("partials/rights") %><% } %>
<% } %>
<% if (status && status.problems.length) { %>
  <ul class="problems">
    <% status.problems.forEach(function (problem) { %><li><%= problem %></li><% }) %>
  </ul>
<% } %>

<section class="card now" data-player="<%= bot.id %>">
  <div class="row">
    <h2 data-now="title"><%= song ? song.title : "Gerade läuft nichts." %></h2>
    <span class="pill" data-now="state">
      <% if (song && song.paused) { %>Pausiert<% } else if (song) { %>Läuft<% } else { %>Leer<% } %>
    </span>
  </div>
  <p class="muted">
    <a data-now="source-link" rel="noopener noreferrer" target="_blank" <% if (!(song && song.sourceHref)) { %>hidden<% } %> href="<%= song && song.sourceHref ? song.sourceHref : "" %>"><%= song && song.sourceHref ? song.source : "" %></a>
    <span data-now="source-text" <% if (song && song.sourceHref) { %>hidden<% } %>><%= song && !song.sourceHref ? song.source : "" %></span>
  </p>
  <div class="meter" aria-hidden="true"><span data-now="bar" style="width: <%= song && song.progress != null ? song.progress : 0 %>%"></span></div>
  <p class="mono"><span data-now="position"><%= song && song.positionLabel ? song.positionLabel : "0:00" %></span> / <span data-now="length"><%= song && song.lengthLabel ? song.lengthLabel : "--:--" %></span></p>

  <% if (access.canControl) { %>
    <div class="transport">
      <form method="post" action="/bots/<%= bot.id %>/action">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="previous">
        <button class="btn" type="submit">Zurück</button>
      </form>
      <form method="post" action="/bots/<%= bot.id %>/action" data-toggle-play>
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="<%= song && !song.paused ? "pause" : "resume" %>">
        <button class="btn btn-primary" type="submit"><%= song && !song.paused ? "Pause" : "Fortsetzen" %></button>
      </form>
      <form method="post" action="/bots/<%= bot.id %>/action">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="next">
        <button class="btn" type="submit">Überspringen</button>
      </form>
      <form method="post" action="/bots/<%= bot.id %>/action" data-confirm="Wiedergabe stoppen?">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="stop">
        <button class="btn" type="submit">Stopp</button>
      </form>
      <form method="post" action="/bots/<%= bot.id %>/action" data-confirm="Warteschlange leeren?">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="clear">
        <button class="btn btn-danger" type="submit">Leeren</button>
      </form>
    </div>
    <div class="transport">
      <% [-30, -10, 10, 30].forEach(function (delta) { %>
        <form method="post" action="/bots/<%= bot.id %>/action">
          <%- include("partials/csrf") %>
          <input type="hidden" name="op" value="nudge">
          <input type="hidden" name="delta" value="<%= delta %>">
          <button class="btn btn-ghost" type="submit"><%= delta > 0 ? "+" : "" %><%= delta %>s</button>
        </form>
      <% }) %>
    </div>
    <div class="split">
      <form method="post" action="/bots/<%= bot.id %>/action" class="inline" id="volume-form">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="volume">
        <label>Lautstärke
          <input name="volume" type="number" min="0" max="100" required value="<%= status && status.volume != null ? status.volume : 50 %>" data-volume-number>
        </label>
        <button class="btn" type="submit">Setzen</button>
      </form>
      <label class="grow">Schieberegler
        <input type="range" min="0" max="100" value="<%= status && status.volume != null ? status.volume : 50 %>" data-volume>
      </label>
    </div>
    <div class="split">
      <form method="post" action="/bots/<%= bot.id %>/action" class="inline">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="repeat">
        <label>Wiederholen
          <select name="mode">
            <option value="off" <%= status && status.repeat === "off" ? "selected" : "" %>>Aus</option>
            <option value="one" <%= status && status.repeat === "one" ? "selected" : "" %>>Titel</option>
            <option value="all" <%= status && status.repeat === "all" ? "selected" : "" %>>Alle</option>
          </select>
        </label>
        <button class="btn" type="submit">Setzen</button>
      </form>
      <form method="post" action="/bots/<%= bot.id %>/action" class="inline">
        <%- include("partials/csrf") %>
        <input type="hidden" name="op" value="random">
        <label>Zufall
          <select name="mode">
            <option value="off" <%= status && status.shuffle === false ? "selected" : "" %>>Aus</option>
            <option value="on" <%= status && status.shuffle === true ? "selected" : "" %>>An</option>
          </select>
        </label>
        <button class="btn" type="submit">Setzen</button>
      </form>
    </div>
  <% } else if (status && status.volume != null) { %>
    <p class="muted">Lautstärke <%= status.volume %></p>
  <% } %>
</section>

<% if (access.canControl) { %>
  <section class="card">
    <h2>Abspielen</h2>
    <form method="post" action="/bots/<%= bot.id %>/action" class="stack">
      <%- include("partials/csrf") %>
      <label>Link oder Ressource
        <input name="resource" required placeholder="https://… oder media/datei.mp3" maxlength="2000">
      </label>
      <div class="row">
        <button class="btn btn-primary" type="submit" name="op" value="play">Sofort spielen</button>
        <button class="btn" type="submit" name="op" value="add">An Warteschlange</button>
      </div>
    </form>
  </section>

  <section class="card">
    <h2>Suche</h2>
    <form method="get" action="/bots/<%= bot.id %>" class="split">
      <label class="grow">Suchbegriff
        <input name="search" value="<%= query %>" maxlength="200" required>
      </label>
      <label>Quelle
        <select name="factory">
          <% ["youtube", "soundcloud", "twitch", "media"].forEach(function (name) { %>
            <option value="<%= name %>" <%= factory === name ? "selected" : "" %>><%= name %></option>
          <% }) %>
        </select>
      </label>
      <button class="btn" type="submit">Suchen</button>
    </form>
    <% if (searchError) { %><p class="flash flash-error" role="alert"><%= searchError %></p><% } %>
    <% if (results.length) { %>
      <ul class="results">
        <% results.forEach(function (item) { %>
          <li>
            <span><%= item.title %></span>
            <form method="post" action="/bots/<%= bot.id %>/action">
              <%- include("partials/csrf") %>
              <input type="hidden" name="index" value="<%= item.index %>">
              <button class="btn btn-primary" type="submit" name="op" value="search-play">Spielen</button>
              <button class="btn" type="submit" name="op" value="search-add">Anhängen</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% } %>

<% if (status && status.queue && status.queue.items.length) { %>
  <section class="card">
    <h2><%= status.queue.title %> <span class="muted">(<%= status.queue.count %>)</span></h2>
    <ol class="queue">
      <% status.queue.items.forEach(function (item) { %>
        <li class="<%= status.queue.index === item.index ? "is-current" : "" %>">
          <span><%= item.title %><% if (item.audioType) { %> <em class="muted"><%= item.audioType %></em><% } %></span>
          <% if (access.canControl) { %>
            <form method="post" action="/bots/<%= bot.id %>/action">
              <%- include("partials/csrf") %>
              <input type="hidden" name="op" value="jump">
              <input type="hidden" name="index" value="<%= item.index %>">
              <button class="btn btn-ghost" type="submit">Springen</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ol>
  </section>
<% } %>
