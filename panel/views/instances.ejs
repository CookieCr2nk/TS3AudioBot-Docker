<header class="page-head">
  <div>
    <h1><%= t("Connection") %></h1>
    <p class="muted"><%= t("TeamSpeak bots in this process. Open one to control its playback.") %></p>
  </div>
</header>
<%- include("partials/botnav") %>

<% if (error) { %>
  <p class="flash flash-error" role="alert"><%= error %></p>
  <% if (rightsHint) { %><%- include("partials/rights") %><% } %>
<% } %>

<form method="post" action="/bots/<%= bot.id %>/action" class="card stack">
  <%- include("partials/csrf") %>
  <input type="hidden" name="op" value="template-create">
  <h2><%= t("Create template") %></h2>
  <div class="split">
    <label class="grow"><%= t("Name") %>
      <input name="name" required maxlength="64" pattern="[A-Za-z0-9_.\-]+" placeholder="lobby">
    </label>
    <button class="btn btn-primary" type="submit"><%= t("Create") %></button>
  </div>
  <p class="muted"><%= t("Identity and password stay in data/bots/<name>/bot.toml.") %></p>
</form>

<% if (instances.length) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th><%= t("ID") %></th><th><%= t("Name") %></th><th><%= t("Server") %></th><th><%= t("Status") %></th><th></th></tr>
      </thead>
      <tbody>
        <% instances.forEach(function (item) { %>
          <tr>
            <td class="mono"><%= item.id == null ? "—" : item.id %></td>
            <td><%= item.name || "—" %><% if (item.current) { %> <span class="pill pill-ok"><%= t("Active") %></span><% } %></td>
            <td>
              <% if (item.name && item.status === "offline") { %>
                <form method="post" action="/bots/<%= bot.id %>/action" class="inline">
                  <%- include("partials/csrf") %>
                  <input type="hidden" name="op" value="template-address">
                  <input type="hidden" name="name" value="<%= item.name %>">
                  <input name="address" value="<%= item.server %>" placeholder="ts.example.com" maxlength="200" required>
                  <button class="btn btn-ghost" type="submit"><%= t("Save") %></button>
                </form>
              <% } else { %><%= item.server || "—" %><% } %>
            </td>
            <td><span class="pill pill-<%= item.status === "connected" ? "ok" : item.status === "connecting" ? "warn" : "bad" %>"><%= item.statusLabel %></span></td>
            <td class="actions-cell">
              <% if (item.name && item.status === "offline") { %>
                <form method="post" action="/bots/<%= bot.id %>/action">
                  <%- include("partials/csrf") %>
                  <input type="hidden" name="op" value="connect">
                  <input type="hidden" name="name" value="<%= item.name %>">
                  <button class="btn" type="submit"><%= t("Start") %></button>
                </form>
              <% } %>
              <% if (item.id != null) { %>
                <form method="post" action="/bots/<%= bot.id %>/action" data-confirm="<%= t("Disconnect this instance?") %>">
                  <%- include("partials/csrf") %>
                  <input type="hidden" name="op" value="disconnect">
                  <input type="hidden" name="instanceId" value="<%= item.id %>">
                  <button class="btn btn-danger" type="submit"><%= t("Disconnect") %></button>
                </form>
              <% } %>
              <% if (item.name || item.id != null) { %>
                <form method="post" action="/bots/<%= bot.id %>/action">
                  <%- include("partials/csrf") %>
                  <input type="hidden" name="op" value="use-instance">
                  <input type="hidden" name="name" value="<%= item.name %>">
                  <input type="hidden" name="instanceId" value="<%= item.id == null ? "" : item.id %>">
                  <button class="btn btn-ghost" type="submit"><%= t("Open") %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<form method="post" action="/bots/<%= bot.id %>/action" class="card stack">
  <%- include("partials/csrf") %>
  <input type="hidden" name="op" value="template-hosting">
  <h2><%= t("Connection settings") %></h2>
  <p class="muted"><%= t("Saved on the bot template. Empty fields stay unchanged. Passwords are sent to the bot and are not stored in the panel.") %></p>
  <div class="split">
    <label><%= t("Name") %>
      <input name="name" required maxlength="64" pattern="[A-Za-z0-9_.\-]+" value="<%= bot.instanceMode === "template" ? bot.instanceRef : "" %>">
    </label>
    <label class="grow"><%= t("Nickname") %>
      <input name="nickname" maxlength="30" placeholder="Music">
    </label>
  </div>
  <div class="split">
    <label class="grow"><%= t("Default channel") %>
      <input name="channel" maxlength="200" placeholder="<%= t("/5 or Home/Lobby") %>">
    </label>
    <label><%= t("Bitrate (kbps)") %>
      <input name="bitrate" inputmode="numeric" maxlength="2" placeholder="48">
    </label>
  </div>
  <div class="split">
    <label class="grow"><%= t("Server password") %>
      <input name="serverPassword" type="password" maxlength="128" autocomplete="new-password">
    </label>
    <label class="grow"><%= t("Channel password") %>
      <input name="channelPassword" type="password" maxlength="128" autocomplete="new-password">
    </label>
  </div>
  <label><%= t("Start when the process launches") %>
    <select name="run">
      <option value=""><%= t("Leave unchanged") %></option>
      <option value="on"><%= t("Yes") %></option>
      <option value="off"><%= t("No") %></option>
    </select>
  </label>
  <button class="btn btn-primary" type="submit"><%= t("Save") %></button>
</form>

<form method="post" action="/bots/<%= bot.id %>/action" class="card stack">
  <%- include("partials/csrf") %>
  <input type="hidden" name="op" value="bot-setup">
  <h2><%= t("Server admin") %></h2>
  <p class="muted"><%= t("Paste a TeamSpeak privilege key once. It applies to the instance currently used for playback. The key is not stored.") %></p>
  <div class="split">
    <label class="grow"><%= t("Privilege key") %>
      <input name="key" type="password" required maxlength="200" autocomplete="off">
    </label>
    <button class="btn" type="submit"><%= t("Apply") %></button>
  </div>
</form>

<form method="post" action="/bots/<%= bot.id %>/action" class="card stack">
  <%- include("partials/csrf") %>
  <input type="hidden" name="op" value="move">
  <h2><%= t("Channel") %></h2>
  <div class="split">
    <label class="grow"><%= t("Channel path or /ID") %>
      <input name="channel" required maxlength="200" placeholder="<%= t("/5 or Home/Lobby") %>">
    </label>
    <button class="btn" type="submit"><%= t("Move") %></button>
  </div>
  <p class="muted"><%= t("Applies to the instance selected as the playback control above.") %></p>
</form>

<form method="post" action="/bots/<%= bot.id %>/action" class="card stack danger-zone">
  <%- include("partials/csrf") %>
  <input type="hidden" name="op" value="template-delete">
  <h2><%= t("Delete template") %></h2>
  <p class="muted"><%= t("Deletes the bot configuration inside TS3AudioBot. The confirmation must match the name.") %></p>
  <div class="split">
    <label><%= t("Name") %><input name="name" required maxlength="64"></label>
    <label><%= t("Confirmation") %><input name="confirm" required maxlength="64"></label>
    <button class="btn btn-danger" type="submit"><%= t("Delete") %></button>
  </div>
</form>
