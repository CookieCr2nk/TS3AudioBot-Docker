<section class="card login-card">
  <p class="eyebrow">TS3AudioBot</p>
  <h1>Anmelden</h1>
  <p class="muted">Verwaltung für Bots, Wiedergabe und Zugänge.</p>
  <% if (error) { %><p class="flash flash-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Benutzername
      <input name="username" autocomplete="username" required value="<%= username %>" maxlength="32">
    </label>
    <label>Passwort
      <input name="password" type="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-primary" type="submit">Anmelden</button>
  </form>
</section>
