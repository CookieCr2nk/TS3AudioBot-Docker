# Copy the keys you change into the repository-root .env.
# Docker Compose reads that file, not this one.

# GHCR tag for the bot and the panel. main is the release line.
# develop follows the develop branch. Leave this unset to use main.
# IMAGE_TAG=develop

PANEL_DB_NAME=ts3panel
PANEL_DB_USER=ts3panel
PANEL_DB_PASSWORD=change-me
PANEL_DB_ROOT_PASSWORD=change-me-root
# Only for docker-compose.panel-external-db.yml. Ignored by the bundled MariaDB.
# Use host.docker.internal when the database runs on the Docker host.
PANEL_DB_HOST=
PANEL_DB_PORT=3306
PANEL_TOKEN_KEY=change-me-to-a-long-random-string
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=
PANEL_PORT=8080
PANEL_COOKIE_SECURE=false
PANEL_TRUST_PROXY=0
